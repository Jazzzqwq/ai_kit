# ai_kit 本地密钥模板 —— 复制为 .env 后填写 (.env 已在 .gitignore 里, 不要提交)
#   PowerShell: Copy-Item .env.example .env
# key 一律走环境变量 / .env, 绝不写进 ai_kit/config.py

# 用哪个 provider: deepseek / doubao / ollama / qianwen
AI_ACTIVE_PROVIDER=qianwen

# --- qianwen ---
QIANWEN_API_KEY=
#QIANWEN_MODEL=qwen-plus
#QIANWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# --- DeepSeek ---
#DEEPSEEK_API_KEY=

# --- 豆包 (火山方舟: MODEL 填你创建的 endpoint id) ---
#DOUBAO_API_KEY=
#DOUBAO_MODEL=ep-xxxxxxxxxx

# --- 本地 Ollama: 无需 key, 只要服务起着就行 ---
#OLLAMA_MODEL=qwen2.5:7b
#OLLAMA_BASE_URL=http://localhost:11434/v1

# 多家共用一个 key 变量时的通用兜底 (优先级低于上面的 {PROVIDER}_API_KEY)
#AI_API_KEY=

# 想换 .env 位置时指定绝对路径
#AI_KIT_ENV_FILE=
